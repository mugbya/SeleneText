{
  "name": "selene-client",
  "version": "1.0.0",
  "description": "Hello World!",
  "main": "main.js",
  "scripts": {
    "build": "electron-builder",
    "start": "electron .",
    "dev": "concurrently -k -n UI,ELECTRON -c cyan,green \"yarn dev:ui\" \"yarn dev:electron\"",
    "dev:ui": "cd ../selene-ui-react && yarn dev",
    "dev:electron": "wait-on -t 10000 tcp:5173 && echo '✅ UI ready, starting Electron...' && electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "mugbya",
  "license": "apache-2.0",
  "packageManager": "yarn@4.6.0",
  "devDependencies": {
    "@types/react": "^19.1.6",
    "concurrently": "^9.1.2",
    "electron": "^36.3.2",
    "electron-builder": "26.0.12",
    "wait-on": "^8.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mugbya/SeleneText.git"
  },
  "build": {
    "asar": false,
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "node_modules/**",
      "package.json"
    ],
    "appId": "com.yourdomain.selenetext",
    "productName": "Selene Text",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "src/assets/logo/logo.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "i18next": "^25.2.1",
    "lodash": "^4.17.21"
  }
}
